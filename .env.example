# 이 파일을 복사해서 .env 로 만들고 값을 채우세요. (.env 는 git에 올라가지 않습니다)
DB_NAME=authdb
DB_USER=authuser
DB_PASSWORD=change-me

# JWT 서명 비밀키. 생성: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# 초기 관리자 계정. 앱 시작 시 없으면 만든다. 비워 두면 만들지 않는다.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
